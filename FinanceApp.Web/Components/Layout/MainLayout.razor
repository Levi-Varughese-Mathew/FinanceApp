@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-950 text-slate-100 flex">
    <!-- Outer shell capped at 1200px, includes the entire app-->
    <div class="max-w-[1200px] w-full mx-auto min-h-screen flex flex-col border-x border-slate-800/60 shadow-2xl relative">

        <!-- Mobile Top Navigation Bar (Visible only on small screens) -->
        <div class="md:hidden flex items-center justify-between p-4 bg-slate-900 border-b border-slate-800 z-50">
            <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-purple-600 flex items-center justify-center font-bold text-white text-xs shadow-lg shadow-purple-600/30">C</div>
                <span class="font-bold text-base tracking-wide text-white">LCUBE Finance</span>
            </div>
            <button @onclick="ToggleMobileMenu" class="p-2 text-slate-400 hover:text-white focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    @if (isMobileMenuOpen)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    }
                </svg>
            </button>
        </div>

        <!-- Sidebar / Navigation Shell -->
        <!-- Here, the default flex direction (row) is used-->
        <div class="flex flex-1 min-h-0 relative">
            <aside class="@(isMobileMenuOpen ? "flex" : "hidden") md:flex w-full md:w-64 bg-slate-900 border-r border-slate-800 flex-col justify-between shrink-0 absolute md:relative z-40 inset-y-0 left-0">
                <div>
                    <!-- Navigation Links -->
                    @* <nav class="p-4 space-y-1.5" @onclick="CloseMobileMenu">
                        <NavLink href="/" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Dashboard
                        </NavLink>
                        <NavLink href="/accounts" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Accounts
                        </NavLink>
                        <NavLink href="/income" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Income
                        </NavLink>
                        <NavLink href="/expense" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Expenses
                        </NavLink>
                        <NavLink href="/savings" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Savings
                        </NavLink>
                        <NavLink href="/debts" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Debts
                        </NavLink>
                        <NavLink href="/budget-planner" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Budget Planner
                        </NavLink>
                    </nav> *@

                    <nav class="p-4 space-y-1.5" @onclick="CloseMobileMenu">
                        <!-- Dashboard: Grid / Speedometer -->
                        <NavLink href="/" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                            Dashboard
                        </NavLink>

                        <!-- Accounts: Wallet / Card -->
                        <NavLink href="/accounts" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Accounts
                        </NavLink>

                        <!-- Income: Trending Up / Arrow Down Left -->
                        <NavLink href="/income" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path></svg>
                            Income
                        </NavLink>

                        <!-- Expenses: Trending Down / Arrow Up Right -->
                        <NavLink href="/expense" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path></svg>
                            Expenses
                        </NavLink>

                        <!-- Savings: Bank Notes / Vault -->
                        <NavLink href="/savings" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            Savings
                        </NavLink>

                        <!-- Debts: Scale / Credit Card Alert -->
                        <NavLink href="/debts" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Debts
                        </NavLink>

                        <!-- Budget Planner: Calendar / Calculator -->
                        <NavLink href="/budget-planner" Match="NavLinkMatch.All"
                                 class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-400 hover:text-white hover:bg-slate-800/50"
                                 ActiveClass="bg-purple-600/10 text-purple-400 font-semibold border border-purple-500/20">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                            Budget Planner
                        </NavLink>
                    </nav>
                </div>

                <!-- User Profile Footer in Sidebar -->
                <div class="p-4 border-t border-slate-800/60 flex items-center gap-3 bg-slate-900">
                    <div class="w-10 h-10 rounded-full bg-purple-600/20 border border-purple-500/30 flex items-center text-purple-300 font-bold justify-center">FA</div>
                    <div class="overflow-hidden">
                        <div class="text-sm font-semibold text-white truncate">Ferra Alexandra</div>
                        <div class="text-xs text-slate-400 truncate">UI Designer</div>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
                <main class="w-full mx-auto flex-1 p-6 md:p-8 flex justify-center">
                    <div class="w-full space-y-6">
                        @Body
                    </div>
                </main>
            </div>
        </div>

    </div>
</div>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void CloseMobileMenu() => isMobileMenuOpen = false;
}