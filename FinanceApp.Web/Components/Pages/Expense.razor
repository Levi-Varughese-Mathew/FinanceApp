@page "/expense"
@rendermode InteractiveServer
@using FinanceApp.Domain.Models
@using FinanceApp.Infrastructure.Data
@using FinanceApp.Infrastructure.Services

@inject AccountService AccountService
@inject TransactionService TransactionService

<div class="space-y-6 max-w-full overflow-hidden">
    <!-- Header & Action Button -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white">Expenses</h1>
            <p class="text-sm text-slate-400">View and manage monthly expenses</p>
        </div>
        <!--This is the button used to open the add new expense window-->
        <button @onclick="OpenAddModal" class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-4 py-2 rounded-xl text-sm transition-all shadow-lg shadow-emerald-900/30 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Expense
        </button>
    </header>

    <!-- Content Card Container with Responsive Min-Width & Scroll -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-xl overflow-x-auto">
        @if (expenses == null)
        {
            <p class="text-slate-400 py-4">Loading expenses...</p>
        }
        else if (!expenses.Any())
        {
            <p class="text-slate-400 py-4">No expenses found for this month.</p>
        }
        @* When expenses have been retrieved from the database. Not empty *@
        else
        {
            <table class="w-full text-left border-collapse text-sm min-w-[650px]">
                <thead>
                    <tr class="border-b border-slate-800 text-slate-400 uppercase text-xs">
                        <th class="p-3">Date</th>
                        <th class="p-3">Description</th>
                        <th class="p-3 text-right">Amount</th>
                        <th class="p-3 text-center w-12">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    @foreach (var transaction in expenses)
                    {
                        // Check if the current row is expanded. This is done by comparing the current transaction's Id with the expandedRowId. If they match, it means this row is currently expanded and should show its details. Otherwise, it remains collapsed.
                        // When the user clicks on a row, the ToggleRow method is called, which updates the expandedRowId. If the same row is clicked again, it collapses by setting expandedRowId to null.
                        bool isExpanded = expandedRowId == transaction.Id; 

                        <!-- Main Row (Clickable) -->
                        <tr @onclick="() => ToggleRow(transaction.Id)" class="cursor-pointer text-slate-300 hover:bg-slate-800/40 transition-colors @(isExpanded ? "bg-slate-800/50" : "")">
                            <td class="p-3 font-semibold">@transaction.Date.ToString("dd/MM/yyyy")</td>
                            <td class="p-3 font-medium text-white">@transaction.Description</td>
                            <td class="p-3 text-right text-rose-400 font-medium">£@transaction.Amount.ToString("N2")</td>

                            <!-- Action buttons use stopPropagation so clicking them doesn't toggle the row -->
                            <td class="p-3 text-center" @onclick:stopPropagation="true">
                                <div class="flex items-center justify-center gap-2">
                                    <!-- Edit Button -->
                                    <button @onclick="() => OpenEditModal(transaction)" class="p-1.5 bg-slate-800 hover:bg-blue-600/20 text-slate-400 hover:text-blue-400 rounded-lg transition-colors" title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </button>
                                    <!-- Delete Button -->
                                    <button @onclick="() => PromptDelete(transaction)" class="p-1.5 bg-slate-800 hover:bg-rose-600/20 text-slate-400 hover:text-rose-400 rounded-lg transition-colors" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                    <!-- Chevron Indicator -->
                                    @* <svg class="w-4 h-4 text-slate-500 transform transition-transform @(isExpanded ? "rotate-180" : "") ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg> *@
                                </div>
                            </td>
                        </tr>

                        <!-- Expandable Details Accordion Row -->
                        @if (isExpanded)
                        {
                            <tr class="bg-slate-950/40">
                                <td colspan="4" class="p-4">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-400 bg-slate-900/80 border border-slate-800/80 p-4 rounded-xl">
                                        <div>
                                            <span class="block uppercase font-semibold text-slate-500">Account / Source</span>
                                            <span class="text-white font-medium text-sm mt-0.5 block">@(string.IsNullOrEmpty(transaction.Account.Name) ? "Default Account" : transaction.Account.Name)</span>
                                        </div>
                                        <div>
                                            <span class="block uppercase font-semibold text-slate-500">Notes / Remarks</span>
                                            <span class="text-slate-300 text-sm mt-0.5 block">@(string.IsNullOrEmpty(transaction.Notes) ? "No additional notes provided." : transaction.Notes)</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Add/Edit Expense Modal Dialog. Only true when the button is clicked-->

@if (isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-6">
            <div class="flex justify-between items-center border-b border-slate-800 pb-4">
                <h3 class="text-lg font-bold text-white">Add New Expense</h3>
                <button @onclick="CloseAddModal" class="text-slate-400 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Form Inputs -->
            <div class="space-y-4">
                <div>
                    @* Shows the description of the expense *@
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Description</label>
                    <input type="text" @bind="activeExpense.Description" placeholder="e.g., Grocery shopping" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        @* Shows the amount of the expense. *@
                        <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Amount (£)</label>
                        <input type="number" step="0.01" @bind="activeExpense.Amount" placeholder="0.00" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" />
                    </div>
                    <div>
                        @* Date *@
                        <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Date</label>
                        <input type="date" @bind="activeExpense.Date" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" />
                    </div>

                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Account</label>
                    <select @bind="activeExpense.AccountId" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500 cursor-pointer">
                        
                        @* Get dynamic account names from the database or service in the future. For now, hardcoded options are used. *@
                        @if (accounts != null && accounts.Any())
                        {
                            @foreach (var account in accounts)
                                { <option value="@account.Id">@account.Name</option> }
                        }
                        else { <option disabled>No accounts available</option> }
                        )

                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Notes (Optional)</label>
                    <textarea @bind="activeExpense.Notes" rows="2" placeholder="Add any details..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500 resize-none"></textarea>
                </div>
            </div>

            <!-- Modal Actions -->
            <div class="flex justify-end gap-3 pt-2">
                <button @onclick="CloseAddModal" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                    Cancel
                </button>
                <button @onclick="SaveExpense" class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-5 py-2 rounded-xl text-sm transition-all shadow-lg shadow-emerald-900/30">
                    @(isEditing ? "Update Expense" : "Save Expense")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal Dialog -->
@if (isDeleteModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-sm p-6 shadow-2xl space-y-4">
            <h3 class="text-lg font-bold text-white">Confirm Deletion</h3>
            <p class="text-sm text-slate-400">Are you sure you want to delete <span class="text-white font-medium">@expenseToDelete?.Description</span>? This action cannot be undone.</p>

            <div class="flex justify-end gap-3 pt-2">
                <button @onclick="CloseDeleteModal" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                    Cancel
                </button>
                <button @onclick="ConfirmDelete" class="bg-rose-600 hover:bg-rose-500 text-white font-medium px-5 py-2 rounded-xl text-sm transition-all shadow-lg shadow-rose-900/30">
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction>? expenses;
    private List<Account>? accounts; // This will hold the list of accounts fetched from the AccountService. It is used to populate the dropdown in the add expense modal.
    private int? expandedRowId = null;

    // Modal states
    private bool isModalOpen = false;
    private bool isDeleteModalOpen = false;
    private bool isEditing = false; // Flag to determine if the modal is in edit mode

    // Model shared for both adding and editing expenses. This will hold the data for the new or edited expense.
    private Transaction activeExpense = new();
    private Transaction? expenseToDelete = null; // Holds the expense that is selected for deletion.

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    // Load expenses and accounts from the respective services. This method is called during component initialization to fetch the necessary data for display and interaction.
    private async Task LoadData()
    {
        expenses = await TransactionService.GetExpensesForMonthAsync();
        accounts = await AccountService.GetAllAccountsAsync();
    }

    // Toggle the expanded state of a row based on its ID. If the row is already expanded, collapse it; otherwise, expand it.
    private void ToggleRow(int id)
    {
        // If the clicked row is already expanded, collapse it by setting expandedRowId to null. Otherwise, set expandedRowId to the clicked row's ID to expand it.
        if (expandedRowId == id) { expandedRowId = null; }
        else { expandedRowId = id; }
    }


    // Models for opening and closing the add expense modal. When opening the modal, the activeExpense model is reset to default values for adding a new expense. When editing, it populates the activeExpense model with the selected expense's data.
    private void OpenAddModal()
    {
        // Reset the newExpense model to default values when opening the modal
        activeExpense = new Transaction { AccountId = 1 , Date = DateTime.Today, Type = Domain.Enums.TransactionType.Expense };
        isModalOpen = true;
    }

    private void CloseAddModal()
    {
        isModalOpen = false;
    }

    // Model for editing an existing expense. It populates the activeExpense model with the selected expense's data and opens the modal in edit mode.
    private void OpenEditModal(Transaction expense)
    {
        activeExpense = new Transaction
        {
            Id = expense.Id,
            Description = expense.Description,
            Amount = expense.Amount,
            Date = expense.Date,
            AccountId = expense.AccountId,
            Account = expense.Account,
            CategoryId = expense.CategoryId,
            Category = expense.Category,
            Notes = expense.Notes,
            Type = Domain.Enums.TransactionType.Expense
        };

        isEditing = true; // Set the flag to indicate that we are in edit mode
        isModalOpen = true;
    }

    private void CloseEditModal()
    {
        isModalOpen = false;
        isEditing = false; // Reset the edit mode flag when closing the modal
    }

    // Method to prompt the user for deletion confirmation. It sets the expenseToDelete variable to the selected expense and opens the delete confirmation modal.
    private void PromptDelete(Transaction expense)
    {
        expenseToDelete = expense; // Set the expense to delete
        isDeleteModalOpen = true; // Open the delete confirmation modal
    }

    // To close the delete modal window
    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        expenseToDelete = null; // Reset the expense to delete when closing the modal
    }

    // Method to save the expense, either by adding a new one or updating an existing one based on the isEditing flag. After saving, it closes the modal and refreshes the list of expenses.
    private async Task SaveExpense()
    {
        if (isEditing)
        {
            // If editing, update the existing expense; otherwise, add a new expense
            await TransactionService.UpdateTransactionAsync(activeExpense);
        }
        else
        {
            // If adding a new expense, call the service to add it.
            await TransactionService.AddTransactionAsync(activeExpense);
        }


        isModalOpen = false;
        // Refresh your list here if needed
        await LoadData();
        // expenses = await TransactionService.GetExpensesForMonthAsync();
    }

    // Method to delete the expense after user confirmation
    private async Task ConfirmDelete()
    {
        if (expenseToDelete != null)
        {
            // Delete the expense using the service
            await TransactionService.DeleteTransactionAsync(expenseToDelete.Id);

            // refresh the list of expenses after deletion
            await LoadData();

            CloseDeleteModal();
        }
    }
}