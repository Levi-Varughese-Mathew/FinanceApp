@page "/income"
@using FinanceApp.Domain.Models
@using FinanceApp.Infrastructure.Data
@using FinanceApp.Infrastructure.Services

@inject AccountService AccountService
@inject TransactionService TransactionService
@inject CategoryService CategoryService

<div class="space-y-6 max-w-[1000px] w-full mx-auto px-4 sm:px-0">
    <!-- Header & Action Button -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Income</h1>
            <p class="text-sm text-slate-400">View and manage monthly income</p>
        </div>
        <button @onclick="OpenAddModal" class="bg-slate-100 hover:bg-white text-slate-950 font-medium px-4 py-2 rounded-xl text-sm transition-all shadow-lg flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Income
        </button>
    </header>

    <!-- Content List Container with Minimum Width Wrapper for Consistency -->
    <div class="w-full pb-2">
        <div class="space-y-3">
            @if (incomes == null)
            {
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 text-center text-slate-400">Loading incomes...</div>
            }
            else if (!incomes.Any())
            {
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 text-center text-slate-400">No incomes found for this month.</div>
            }
            else
            {
                @foreach (var transaction in incomes)
                {
                    bool isExpanded = expandedRowId == transaction.Id;

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl transition-all overflow-hidden shadow-sm hover:border-slate-700">
                        <!-- Main Clickable Row. Stacks vertically on sm+ (smaller displays) -->
                        <div @onclick="() => ToggleRow(transaction.Id)" class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 cursor-pointer select-none">
                            <!-- Left: Date & Description -->
                            <div class="flex items-center gap-4 min-w-0">
                                <div class="text-xs font-semibold text-slate-400 bg-slate-950 border border-slate-800 px-3 py-1.5 rounded-lg shrink-0">
                                    @transaction.Date.ToString("dd MMM yyyy")
                                </div>
                                <div class="min-w-0">
                                    <h3 class="text-sm font-semibold text-white truncate">@transaction.Description</h3>
                                    <p class="text-xs text-slate-500 mt-0.5">Click to view details</p>
                                </div>
                            </div>

                            <!-- Right: Amount & Actions -->
                            <div class="flex items-center justify-between sm:justify-end gap-4 shrink-0 pt-2 sm:pt-0 border-t border-slate-800/40 sm:border-t-0" @onclick:stopPropagation="true">
                                <span class="text-sm font-bold text-slate-200">£@transaction.Amount.ToString("N2")</span>

                                <div class="flex items-center gap-1.5">
                                    <button @onclick="() => OpenEditModal(transaction)" class="p-2 bg-slate-800/60 hover:bg-slate-800 text-slate-400 hover:text-white rounded-lg transition-colors" title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </button>
                                    <button @onclick="() => PromptDelete(transaction)" class="p-2 bg-slate-800/60 hover:bg-slate-800 text-slate-400 hover:text-rose-400 rounded-lg transition-colors" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Expandable Details Section (Colored Pills, No Headers) -->
                        @if (isExpanded)
                        {
                            <div class="px-5 pb-5 pt-3 border-t border-slate-800/60 bg-slate-950/40 space-y-4">
                                <div class="flex flex-wrap items-center gap-3">
                                    <!-- Account Pill (Emerald Tint) -->
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-2"></span>
                                        @(transaction.Account?.Name ?? "Default")
                                    </span>

                                    <!-- Category Pill (Indigo Tint) -->
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 mr-2"></span>
                                        @(transaction.Category?.Name ?? "Unassigned")
                                    </span>
                                </div>

                                <!-- Notes -->
                                <div>
                                    <span class="block uppercase font-semibold text-slate-500 mb-1 text-xs">Notes / Remarks</span>
                                    <p class="text-slate-300 text-sm bg-slate-900 border border-slate-800/80 p-3 rounded-xl break-words whitespace-pre-wrap">
                                        @(string.IsNullOrEmpty(transaction.Notes) ? "No additional notes provided." : transaction.Notes)
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Add/Edit Expense Modal Dialog -->
@if (isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-6">
            <div class="flex justify-between items-center border-b border-slate-800 pb-4">
                <h3 class="text-lg font-bold text-white">@(isEditing ? "Edit Income" : "Add New Income")</h3>
                <button @onclick="CloseAddModal" class="text-slate-400 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Form Inputs -->
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Description</label>
                    <input type="text" @bind="activeExpense.Description" placeholder="e.g., Grocery shopping" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-slate-500" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Amount (£)</label>
                        <input type="number" step="0.01" @bind="activeExpense.Amount" placeholder="0.00" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-slate-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Date</label>
                        <input type="date" @bind="activeExpense.Date" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-slate-500" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Account</label>
                    <select @bind="activeExpense.AccountId" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-slate-500 cursor-pointer">
                        @if (accounts != null && accounts.Any())
                        {
                            @foreach (var account in accounts)
                            {
                                <option value="@account.Id">@account.Name</option>
                            }
                        }
                        else
                        {
                            <option disabled>No accounts available</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Category</label>
                    <select @bind="activeExpense.CategoryId" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-slate-500 cursor-pointer">
                        @if (categories != null && categories.Any())
                        {
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                        else
                        {
                            <option disabled>No categories available</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Notes (Optional)</label>
                    <textarea @bind="activeExpense.Notes" rows="2" placeholder="Add any details..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-slate-500 resize-none"></textarea>
                </div>
            </div>

            <!-- Modal Actions -->
            <div class="flex justify-end gap-3 pt-2">
                <button @onclick="CloseAddModal" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                    Cancel
                </button>
                <button @onclick="SaveExpense" class="bg-slate-100 hover:bg-white text-slate-950 font-medium px-5 py-2 rounded-xl text-sm transition-all shadow-lg">
                    @(isEditing ? "Update Expense" : "Save Expense")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal Dialog -->
@if (isDeleteModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-sm p-6 shadow-2xl space-y-4">
            <h3 class="text-lg font-bold text-white">Confirm Deletion</h3>
            <p class="text-sm text-slate-400">Are you sure you want to delete <span class="text-white font-medium">@expenseToDelete?.Description</span>? This action cannot be undone.</p>

            <div class="flex justify-end gap-3 pt-2">
                <button @onclick="CloseDeleteModal" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                    Cancel
                </button>
                <button @onclick="ConfirmDelete" class="bg-slate-100 hover:bg-white text-slate-950 font-medium px-5 py-2 rounded-xl text-sm transition-all shadow-lg">
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction>? incomes;
    private List<Account>? accounts;
    private List<Category>? categories;
    private int? expandedRowId = null;

    private bool isModalOpen = false;
    private bool isDeleteModalOpen = false;
    private bool isEditing = false;

    private Transaction activeExpense = new();
    private Transaction? expenseToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        incomes = await TransactionService.GetIncomeForMonthAsync();
        accounts = await AccountService.GetAllAccountsAsync();
        categories = await CategoryService.GetIncomeCategoriesAsync();
    }

    private void ToggleRow(int id)
    {
        if (expandedRowId == id) { expandedRowId = null; }
        else { expandedRowId = id; }
    }

    private void OpenAddModal()
    {
        activeExpense = new Transaction { AccountId = accounts?.FirstOrDefault()?.Id ?? 1, CategoryId = categories?.FirstOrDefault()?.Id ?? 1, Date = DateTime.Today, Type = Domain.Enums.TransactionType.Income };
        isEditing = false;
        isModalOpen = true;
    }

    private void CloseAddModal()
    {
        isModalOpen = false;
        isEditing = false;
    }

    private void OpenEditModal(Transaction expense)
    {
        activeExpense = new Transaction
        {
            Id = expense.Id,
            Description = expense.Description,
            Amount = expense.Amount,
            Date = expense.Date,
            AccountId = expense.AccountId,
            CategoryId = expense.CategoryId,
            Notes = expense.Notes,
            Type = Domain.Enums.TransactionType.Income
        };

        isEditing = true;
        isModalOpen = true;
    }

    private void PromptDelete(Transaction expense)
    {
        expenseToDelete = expense;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        expenseToDelete = null;
    }

    private async Task SaveExpense()
    {
        if (string.IsNullOrWhiteSpace(activeExpense.Description) || activeExpense.Amount <= 0 || activeExpense.AccountId <= 0 || activeExpense.CategoryId <= 0 || activeExpense.Date == default)
        {
            return;
        }

        if (isEditing)
        {
            await TransactionService.UpdateTransactionAsync(activeExpense);
        }
        else
        {
            await TransactionService.AddTransactionAsync(activeExpense);
        }

        isModalOpen = false;
        isEditing = false;
        await LoadData();
    }

    private async Task ConfirmDelete()
    {
        if (expenseToDelete != null)
        {
            await TransactionService.DeleteTransactionAsync(expenseToDelete.Id);
            await LoadData();
            CloseDeleteModal();
        }
    }
}